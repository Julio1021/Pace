<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Abertura do Android 12+: mesmo fundo claro e a cabeça do Guará. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/pace_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/pace_splash</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/pace_splash</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
